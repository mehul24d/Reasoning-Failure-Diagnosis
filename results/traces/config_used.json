{
  "profile": "reduced",
  "harness_config": "configs/gemma2_2b.yaml",
  "out_dir": "/opt/rfd/results/traces",
  "seed": 42,
  "split_fractions": {
    "train": 0.5,
    "dev": 0.2,
    "test": 0.3
  },
  "instances_per_template": 4,
  "variants": [
    "main",
    "noop"
  ],
  "chunk_size": 64,
  "extract_chunk": 64,
  "parse_sample_size": 30,
  "harness": {
    "seed": 42,
    "model": {
      "model_name": "google/gemma-2-2b-it",
      "device": "auto",
      "dtype": "float32",
      "attn_implementation": "eager",
      "system_role": false,
      "trust_remote_code": false
    },
    "generation": {
      "do_sample": false,
      "max_new_tokens": 384,
      "batch_size": 24
    },
    "forward_batch_size": 8,
    "acts_dtype": "float16",
    "cache_dir": ".cache"
  }
}